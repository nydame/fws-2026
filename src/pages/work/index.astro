---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateRange } from '../../lib/date-range';
import { compareByOrder } from '../../lib/project-order';

const projects = await getCollection('projects', ({ data }) => !data.draft);

const recentWork = projects.filter((project) => project.data.era === 'recent').sort(compareByOrder);
const earlierWork = projects.filter((project) => project.data.era === 'earlier').sort(compareByOrder);
---

<BaseLayout
	title="Work · Firefly Web Services"
	description="Services, Recent Work, and a decade of Earlier Work for Mission-Driven Organizations."
>
	<h1>Work</h1>

	<section aria-labelledby="services-heading">
		<h2 id="services-heading">Services</h2>
		<!-- Placeholder services copy; replace with Felicia's own wording. -->
		<p>
			Web engineering for Mission-Driven Organizations, from architecture through going live: full-stack
			development on modern infrastructure that doesn't depend on someone else's abandoned server.
		</p>
	</section>

	<section aria-labelledby="recent-work-heading">
		<h2 id="recent-work-heading">Recent Work</h2>
		<ul>
			{
				recentWork.map((project) => (
					<li>
						<a href={`/work/${project.id}/`}>{project.data.title}</a>
						<p>{project.data.summary}</p>
						<p>{formatDateRange(project.data)}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section aria-labelledby="earlier-work-heading">
		<h2 id="earlier-work-heading">Earlier Work</h2>
		<ul>
			{
				earlierWork.map((project) => (
					<li>
						{/* Same shape as Recent Work, but the title is bold rather than a
						    link: an Earlier Work Project has no /work/<slug>/ page. */}
						<strong>{project.data.title}</strong>
						<p>{project.data.summary}</p>
						{/* Kept on one line: a newline between the expressions would put
						    whitespace before "for". An unnamed Client appends nothing at
						    all rather than a stand-in (CONTEXT.md). */}
						<p>{formatDateRange(project.data)}{project.data.client && ` for ${project.data.client}`}</p>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>
