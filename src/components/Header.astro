---
import FireflyMark from './FireflyMark.astro';

// /blog/ is deliberately absent until Posts exist (CONTEXT.md, ADR-none —
// see the parent spec's "nothing advertises an empty room" decision).
const navItems = [
	{ href: '/work/', label: 'Work' },
	{ href: '/about/', label: 'About' },
	{ href: '/hire/', label: 'Hire' },
];
---

<header>
	<p class="site-title">
		<a href="/"><FireflyMark class="mark" /><span>Firefly Web Services</span></a>
	</p>
	<nav aria-label="Primary">
		<ul>
			{
				navItems.map((item) => (
					<li>
						<a href={item.href}>{item.label}</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		max-width: calc(var(--measure) + 2 * var(--gutter));
		margin-inline: auto;
		padding: 1rem var(--gutter);
	}

	.site-title {
		margin: 0;
		font-weight: bold;
	}

	.site-title a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: inherit;
	}

	.site-title :global(.mark) {
		width: auto;
		height: 2.25rem;
	}

	nav ul {
		display: flex;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		color: inherit;
	}
</style>
