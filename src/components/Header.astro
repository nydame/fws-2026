---
// /blog/ is deliberately absent until Posts exist (CONTEXT.md, ADR-none —
// see the parent spec's "nothing advertises an empty room" decision).
const navItems = [
	{ href: '/work/', label: 'Work' },
	{ href: '/about/', label: 'About' },
	{ href: '/hire/', label: 'Hire' },
];
---

<header>
	<p class="site-title"><a href="/">Firefly Web Services</a></p>
	<nav aria-label="Primary">
		<ul>
			{
				navItems.map((item) => (
					<li>
						<a href={item.href}>{item.label}</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem;
	}

	.site-title {
		margin: 0;
		font-weight: bold;
	}

	.site-title a {
		text-decoration: none;
		color: inherit;
	}

	nav ul {
		display: flex;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
